{
  "info": {
    "name": "inmobiliaria_visita",
    "_postman_id": "ms-visita-001",
    "description": "Colección CRUD y filtros específicos para el microservicio de Visitas - Spring Boot puerto 8084",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8084", "type": "string" },
    { "key": "visita_id", "value": "1", "type": "string" },
    { "key": "cliente_id", "value": "1", "type": "string" },
    { "key": "propiedad_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Listar todas las visitas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Respuesta es un array', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.be.an('array');",
              "});",
              "pm.test('Cada visita tiene los campos requeridos estructurales', () => {",
              "  const b = pm.response.json();",
              "  if (b.length > 0) {",
              "    pm.expect(b[0]).to.have.property('idCliente');",
              "    pm.expect(b[0]).to.have.property('idPropiedad');",
              "    pm.expect(b[0]).to.have.property('idAgente');",
              "    pm.expect(b[0]).to.have.property('fechaVisita');",
              "  }",
              "});",
              "pm.test('Tiempo de respuesta menor a 2000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/visitas",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "visitas"]
        }
      }
    },
    {
      "name": "2. Obtener visita por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('La visita tiene la estructura esperada', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('idCliente');",
              "  pm.expect(b).to.have.property('idPropiedad');",
              "  pm.expect(b).to.have.property('idAgente');",
              "});",
              "pm.test('Tiempo de respuesta menor a 2000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
