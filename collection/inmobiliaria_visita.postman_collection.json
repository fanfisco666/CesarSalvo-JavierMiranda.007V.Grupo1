    {
      "name": "6. Crear visita (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Respuesta tiene los datos de la visita creados', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.idCliente).to.eql(1);",
              "  pm.expect(b.idPropiedad).to.eql(1);",
              "  pm.expect(b.idAgente).to.eql(5);",
              "});",
              "// Guardar ids dinámicamente en el entorno",
              "const b = pm.response.json();",
              "if (b && b.id) { pm.environment.set('visita_id', b.id.toString()); }",
              "else if (b && b.idVisita) { pm.environment.set('visita_id', b.idVisita.toString()); }",
              "if (b && b.idCliente) { pm.environment.set('cliente_id', b.idCliente.toString()); }",
              "if (b && b.idPropiedad) { pm.environment.set('propiedad_id', b.idPropiedad.toString()); }",
              "pm.test('Tiempo de respuesta menor a 2000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": 1,\n  \"idPropiedad\": 1,\n  \"idAgente\": 5,\n  \"fechaVisita\": \"2026-08-15\",\n  \"horaVisita\": \"15:30:00\",\n  \"observaciones\": \"El cliente está muy interesado en evaluar los balcones y estacionamiento.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/visitas",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "visitas"]
        }
      }
