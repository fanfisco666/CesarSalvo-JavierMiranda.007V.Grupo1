{
  "info": {
    "name": "inmobiliaria_contrato",
    "_postman_id": "ms-contrato-003",
    "description": "Colección CRUD para el microservicio de Contratos - Spring Boot puerto 8085",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8085", "type": "string" },
    { "key": "contrato_id", "value": "1", "type": "string" },
    { "key": "cliente_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Listar todos los contratos",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Respuesta es un array', () => { pm.expect(pm.response.json()).to.be.an('array'); });",
        "pm.test('Campos requeridos presentes', () => {",
        "  const b = pm.response.json();",
        "  if (b.length > 0) {",
        "    pm.expect(b[0]).to.have.property('idContrato');",
        "    pm.expect(b[0]).to.have.property('tipoContrato');",
        "    pm.expect(b[0]).to.have.property('estado');",
        "    pm.expect(b[0]).to.have.property('montoTotal');",
        "  }",
        "});",
        "pm.test('Tiempo de respuesta menor a 2000ms', () => { pm.expect(pm.response.responseTime).to.be.below(2000); });"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
      }
    },
    {
      "name": "2. Obtener contrato por ID",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Contrato tiene campos requeridos', () => {",
        "  const b = pm.response.json();",
        "  pm.expect(b).to.have.property('idContrato');",
        "  pm.expect(b).to.have.property('idCliente');",
        "  pm.expect(b).to.have.property('idPropiedad');",
        "  pm.expect(b).to.have.property('idAgente');",
        "  pm.expect(b).to.have.property('tipoContrato');",
        "  pm.expect(b).to.have.property('fechaInicio');",
        "  pm.expect(b).to.have.property('estado');",
        "});",
        "pm.test('Tiempo de respuesta menor a 2000ms', () => { pm.expect(pm.response.responseTime).to.be.below(2000); });"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/contratos/{{contrato_id}}", "host": ["{{base_url}}"], "path": ["api","v1","contratos","{{contrato_id}}"] }
      }
    },
    {
      "name": "3. Obtener contratos por cliente",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Respuesta es un array', () => { pm.expect(pm.response.json()).to.be.an('array'); });",
        "pm.test('Todos pertenecen al mismo cliente', () => {",
        "  const b = pm.response.json();",
        "  const idCliente = parseInt(pm.variables.get('cliente_id'));",
        "  b.forEach(c => pm.expect(c.idCliente).to.eql(idCliente));",
        "});"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/contratos/cliente/{{cliente_id}}", "host": ["{{base_url}}"], "path": ["api","v1","contratos","cliente","{{cliente_id}}"] }
      }
    },
    {
      "name": "4. Obtener contratos por estado ACTIVO",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Respuesta es un array', () => { pm.expect(pm.response.json()).to.be.an('array'); });",
        "pm.test('Todos tienen estado ACTIVO', () => {",
        "  const b = pm.response.json();",
        "  b.forEach(c => pm.expect(c.estado).to.eql('ACTIVO'));",
        "});"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/contratos/estado/ACTIVO", "host": ["{{base_url}}"], "path": ["api","v1","contratos","estado","ACTIVO"] }
      }
    },
    {
      "name": "5. Obtener contratos por estado CERRADO",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Respuesta es un array', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/contratos/estado/CERRADO", "host": ["{{base_url}}"], "path": ["api","v1","contratos","estado","CERRADO"] }
      }
    },
    {
      "name": "6. Crear contrato ARRIENDO (POST)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Contrato creado con datos correctos', () => {",
        "  const b = pm.response.json();",
        "  pm.expect(b).to.have.property('idContrato');",
        "  pm.expect(b.tipoContrato).to.eql('ARRIENDO');",
        "  pm.expect(b.idCliente).to.eql(1);",
        "  pm.expect(b.idPropiedad).to.eql(1);",
        "  pm.expect(b.idAgente).to.eql(1);",
        "});",
        "const b = pm.response.json();",
        "if (b && b.idContrato) { pm.environment.set('contrato_id', b.idContrato); }",
        "pm.test('Tiempo de respuesta menor a 2000ms', () => { pm.expect(pm.response.responseTime).to.be.below(2000); });"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": 1,\n  \"idPropiedad\": 1,\n  \"idAgente\": 1,\n  \"idVisita\": 1,\n  \"tipoContrato\": \"ARRIENDO\",\n  \"fechaInicio\": \"2025-06-01\",\n  \"fechaFin\": \"2026-06-01\",\n  \"observaciones\": \"Contrato de arriendo por 12 meses\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
      }
    },
    {
      "name": "7. Crear contrato VENTA (POST)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Tipo contrato es VENTA', () => {",
        "  const b = pm.response.json();",
        "  pm.expect(b.tipoContrato).to.eql('VENTA');",
        "});"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": 1,\n  \"idPropiedad\": 2,\n  \"idAgente\": 1,\n  \"idVisita\": 2,\n  \"tipoContrato\": \"VENTA\",\n  \"fechaInicio\": \"2025-06-01\",\n  \"observaciones\": \"Contrato de compraventa\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
      }
    },
    {
      "name": "8. Cambiar estado del contrato (PATCH)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => { pm.response.to.have.status(200); });",
        "pm.test('Estado actualizado correctamente', () => {",
        "  const b = pm.response.json();",
        "  pm.expect(b.estado).to.eql('CERRADO');",
        "});"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/contratos/{{contrato_id}}/estado?estado=CERRADO",
          "host": ["{{base_url}}"],
          "path": ["api","v1","contratos","{{contrato_id}}","estado"],
          "query": [{ "key": "estado", "value": "CERRADO" }]
        }
      }
    },
    {
      "name": "9. Eliminar contrato (DELETE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 204 No Content', () => { pm.response.to.have.status(204); });",
        "pm.test('Body vacío al eliminar', () => { pm.expect(pm.response.text()).to.be.empty; });"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/api/v1/contratos/{{contrato_id}}", "host": ["{{base_url}}"], "path": ["api","v1","contratos","{{contrato_id}}"] }
      }
    },
    {
      "name": "--- CASOS NEGATIVOS ---",
      "item": [
        {
          "name": "N1. GET id inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => { pm.response.to.have.status(404); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{base_url}}/api/v1/contratos/99999", "host": ["{{base_url}}"], "path": ["api","v1","contratos","99999"] }
          }
        },
        {
          "name": "N2. POST sin campos obligatorios → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 Bad Request', () => { pm.response.to.have.status(400); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
          }
        },
        {
          "name": "N3. POST tipo contrato inválido → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 Bad Request', () => { pm.response.to.have.status(400); });",
            "pm.test('Error menciona tipo de contrato', () => {",
            "  const b = pm.response.text();",
            "  pm.expect(b.toLowerCase()).to.include('arriendo');",
            "});"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": 1,\n  \"idPropiedad\": 1,\n  \"idAgente\": 1,\n  \"idVisita\": 1,\n  \"tipoContrato\": \"HIPOTECA\",\n  \"fechaInicio\": \"2025-06-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
          }
        },
        {
          "name": "N4. POST sin fechaInicio → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 Bad Request', () => { pm.response.to.have.status(400); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": 1,\n  \"idPropiedad\": 1,\n  \"idAgente\": 1,\n  \"idVisita\": 1,\n  \"tipoContrato\": \"ARRIENDO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/contratos", "host": ["{{base_url}}"], "path": ["api","v1","contratos"] }
          }
        },
        {
          "name": "N5. PATCH estado en id inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => { pm.response.to.have.status(404); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "PATCH", "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/contratos/99999/estado?estado=CERRADO",
              "host": ["{{base_url}}"],
              "path": ["api","v1","contratos","99999","estado"],
              "query": [{ "key": "estado", "value": "CERRADO" }]
            }
          }
        },
        {
          "name": "N6. DELETE id inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => { pm.response.to.have.status(404); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{base_url}}/api/v1/contratos/99999", "host": ["{{base_url}}"], "path": ["api","v1","contratos","99999"] }
          }
        }
      ]
    }
  ]
}
