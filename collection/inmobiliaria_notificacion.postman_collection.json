          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": 1,\n  \"tipo\": \"PAGO_PENDIENTE\",\n  \"mensaje\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/notificaciones", "host": ["{{base_url}}"], "path": ["api","v1","notificaciones"] }
          }
        },
        {
          "name": "N5. PATCH leer en id inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => { pm.response.to.have.status(404); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "PATCH", "header": [],
            "url": { "raw": "{{base_url}}/api/v1/notificaciones/99999/leer", "host": ["{{base_url}}"], "path": ["api","v1","notificaciones","99999","leer"] }
          }
        },
        {
          "name": "N6. DELETE id inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => { pm.response.to.have.status(404); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{base_url}}/api/v1/notificaciones/99999", "host": ["{{base_url}}"], "path": ["api","v1","notificaciones","99999"] }
          }
