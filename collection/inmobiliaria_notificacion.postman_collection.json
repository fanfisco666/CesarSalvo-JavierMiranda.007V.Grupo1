              "raw": "{\n  \"idCliente\": 1,\n  \"tipo\": \"TIPO_INEXISTENTE\",\n  \"mensaje\": \"Mensaje de prueba\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/notificaciones", "host": ["{{base_url}}"], "path": ["api","v1","notificaciones"] }
          }
        },
        {
          "name": "N4. POST mensaje excede 500 caracteres → 400",
          "event": [{ "listen": "test", "script": { "exec": [
